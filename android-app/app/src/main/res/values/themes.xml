<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.JapanReformedTheology" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSecondaryVariant">@color/accent_hover</item>
        <item name="colorOnSecondary">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.JapanReformedTheology.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>
</resources>